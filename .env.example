# Never commit real credentials. Export these values or use the documented systemd file.
BTC_OPTION_SCANNER_CONFIG=config.yaml

# Long-running collector paths. Linux service defaults are documented in deploy/collector.env.example.
BTC_OPTION_DB_PATH=data/collector.sqlite
BTC_OPTION_STATUS_PATH=runtime/collector-status.json
BTC_OPTION_RETENTION_DAYS=30
BTC_OPTION_MIN_FREE_BYTES=2147483648

# Optional read-only authentication. Leave both empty for public-only collection.
# The collector never logs these values and rejects any returned :read_write scope.
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_AUTH_SCOPE="connection account:none trade:none wallet:none"
