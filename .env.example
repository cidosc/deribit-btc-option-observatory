# Never commit real credentials. Export these values or use the documented systemd file.
BTC_OPTION_SCANNER_CONFIG=config.yaml

# Long-running collector paths. Linux service defaults are documented in deploy/collector.env.example.
BTC_OPTION_DB_PATH=data/collector.sqlite
BTC_OPTION_STATUS_PATH=runtime/collector-status.json
BTC_OPTION_COLLECTION_PROFILE=scanner-lite
BTC_OPTION_MAX_INSTRUMENTS=60
BTC_OPTION_MAX_BOOK_INSTRUMENTS=0
BTC_OPTION_TICKER_PERSIST_INTERVAL_SECONDS=60
BTC_OPTION_RETENTION_DAYS=30
BTC_OPTION_MIN_FREE_BYTES=2147483648

# Live research candidates are written locally by default. OneBot notification is optional.
BTC_OPTION_RECOMMENDATIONS_ENABLED=true
BTC_OPTION_RECOMMENDATION_PATH=runtime/latest-recommendation.json
BTC_OPTION_RECOMMENDATION_INTERVAL_SECONDS=60
BTC_OPTION_RECOMMENDATION_TOP_N=3
BTC_OPTION_ALERT_REMINDER_SECONDS=3600
# BTC_OPTION_ONEBOT_WS_URL=ws://127.0.0.1:3001/api
# BTC_OPTION_ONEBOT_TARGET_TYPE=group
# BTC_OPTION_ONEBOT_TARGET_ID=123456789
# BTC_OPTION_ONEBOT_ACCESS_TOKEN=

# Optional read-only authentication. Leave both empty for public-only collection.
# The collector never logs these values and rejects any returned :read_write scope.
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_AUTH_SCOPE="connection account:none trade:none wallet:none"
