# Copy to /etc/btc-option-observatory/collector.env, keep owner root:root and mode 0600.
BTC_OPTION_SCANNER_CONFIG=/opt/deribit-btc-option-observatory/config.yaml
BTC_OPTION_DB_PATH=/var/lib/btc-option-observatory/collector.sqlite
BTC_OPTION_STATUS_PATH=/run/btc-option-observatory/collector-status.json
BTC_OPTION_WS_URL=wss://www.deribit.com/ws/api/v2

# Broad ticker coverage plus a bounded book subset keeps the channel and disk load finite.
BTC_OPTION_TICKER_INTERVAL=agg2
BTC_OPTION_BOOK_INTERVAL=100ms
BTC_OPTION_MAX_INSTRUMENTS=180
BTC_OPTION_MAX_BOOK_INSTRUMENTS=20
BTC_OPTION_COLLECTION_BUFFER_DAYS=30
BTC_OPTION_CATALOG_REFRESH_SECONDS=3600

# Online retention reuses SQLite free pages; it intentionally does not run blocking VACUUM.
BTC_OPTION_RETENTION_DAYS=30
BTC_OPTION_RETENTION_CHECK_SECONDS=3600
BTC_OPTION_STATUS_INTERVAL_SECONDS=30
BTC_OPTION_HEALTH_MAX_AGE_SECONDS=120
BTC_OPTION_MIN_FREE_BYTES=2147483648
BTC_OPTION_LOG_LEVEL=INFO

# Optional file logging. Leave unset to use the systemd journal.
# BTC_OPTION_LOG_FILE=/var/log/btc-option-observatory/collector.log

# Optional Deribit OAuth credentials. Leave both unset for public-only operation.
# Never place a key with write authority here. Returned scopes are checked fail-closed.
# DERIBIT_CLIENT_ID=replace-me
# DERIBIT_CLIENT_SECRET=replace-me
DERIBIT_AUTH_SCOPE="connection account:none trade:none wallet:none"

# Authenticated raw book is opt-in. Set only when credentials above are configured.
# BTC_OPTION_BOOK_INTERVAL=raw
